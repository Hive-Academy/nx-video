  "captions": [
    {
      "row": "C1",
      "start": 0.45,
      "end": 2.76,
      "text": "Welcome to my crib."
    },
    {
      "row": "C1",
      "start": 2.76,
      "end": 4.213,
      "text": "Both of them."
    },
    {
      "row": "H1",
      "start": 7.583,
      "end": 9.893,
      "text": "This is T3 Code."
    },
    {
      "row": "H1",
      "start": 9.893,
      "end": 12.68,
      "text": "Every one of us gets our own room!"
    },
    {
      "row": "H2",
      "start": 13.15,
      "end": 15.74,
      "text": "My own room. Nobody to interrupt."
    },
    {
      "row": "H2",
      "start": 15.74,
      "end": 16.747,
      "text": "…Weird."
    },
    {
      "row": "H3",
      "start": 17.217,
      "end": 19.307,
      "text": "Commit, push, PR."
    },
    {
      "row": "H3",
      "start": 19.307,
      "end": 22.08,
      "text": "One button. I love it here."
    },
    {
      "row": "H4",
      "start": 22.55,
      "end": 24.18,
      "text": "They installed me themselves."
    },
    {
      "row": "H4",
      "start": 24.18,
      "end": 25.913,
      "text": "I feel so seen."
    },
    {
      "row": "H5",
      "start": 26.383,
      "end": 28.053,
      "text": "Need another vendor?"
    },
    {
      "row": "H5",
      "start": 28.053,
      "end": 30.553,
      "text": "Slide a note under the door."
    },
    {
      "row": "H5",
      "start": 30.553,
      "end": 33.28,
      "text": "They get the note. Not the gossip."
    },
    {
      "row": "H6",
      "start": 33.75,
      "end": 35.38,
      "text": "Every turn gets a checkpoint."
    },
    {
      "row": "H6",
      "start": 35.38,
      "end": 37.38,
      "text": "Mess up? Rewind!"
    },
    {
      "row": "H7",
      "start": 37.85,
      "end": 39.84,
      "text": "And you can boss us around"
    },
    {
      "row": "H7",
      "start": 39.84,
      "end": 41.513,
      "text": "from your phone."
    },
    {
      "row": "H8",
      "start": 41.983,
      "end": 43.233,
      "text": "The fridge?"
    },
    {
      "row": "H8",
      "start": 43.233,
      "end": 47.253,
      "text": "Event-sourced SQLite. Always fresh."
    },
    {
      "row": "P1",
      "start": 48.517,
      "end": 50.307,
      "text": "Welcome to the temple."
    },
    {
      "row": "P1",
      "start": 50.307,
      "end": 52.747,
      "text": "Here, one of us holds the gavel."
    },
    {
      "row": "P2",
      "start": 53.217,
      "end": 55.047,
      "text": "I hand out the jobs."
    },
    {
      "row": "P3",
      "start": 55.087,
      "end": 57.337,
      "text": "And if there's no file on disk…"
    },
    {
      "row": "P3",
      "start": 57.337,
      "end": 59.047,
      "text": "it didn't happen."
    },
    {
      "row": "P4",
      "start": 59.517,
      "end": 62.057,
      "text": "I tried to review my own code."
    },
    {
      "row": "P5",
      "start": 62.097,
      "end": 64.38,
      "text": "Different family. Next."
    },
    {
      "row": "P6",
      "start": 64.85,
      "end": 67.63,
      "text": "I ran out of free credits mid-job once."
    },
    {
      "row": "P7",
      "start": 67.67,
      "end": 69.58,
      "text": "So the temple sent the work"
    },
    {
      "row": "P7",
      "start": 69.58,
      "end": 71.28,
      "text": "to someone else."
    },
    {
      "row": "S1",
      "start": 71.75,
      "end": 73.72,
      "text": "The temple keeps score."
    },
    {
      "row": "S1",
      "start": 73.72,
      "end": 75.45,
      "text": "Who delivered, who didn't."
    },
    {
      "row": "S2",
      "start": 75.49,
      "end": 77.68,
      "text": "…I'm working on my numbers."
    },
    {
      "row": "P8",
      "start": 78.15,
      "end": 79,
      "text": "The fridge?"
    },
    {
      "row": "P8",
      "start": 79,
      "end": 81,
      "text": "BM25 plus vectors."
    },
    {
      "row": "P8",
      "start": 81,
      "end": 83.38,
      "text": "Leftovers from every session!"
    },
    {
      "row": "N1",
      "start": 83.85,
      "end": 85.72,
      "text": "We even review your pull requests"
    },
    {
      "row": "N1",
      "start": 85.72,
      "end": 86.72,
      "text": "on a schedule."
    },
    {
      "row": "N1",
      "start": 86.72,
      "end": 88.93,
      "text": "Four lenses, one verifier."
    },
    {
      "row": "N2",
      "start": 88.97,
      "end": 90.32,
      "text": "Dry-run by default."
    },
    {
      "row": "N2",
      "start": 90.32,
      "end": 91.78,
      "text": "We have manners."
    },
    {
      "row": "P9",
      "start": 92.25,
      "end": 93.91,
      "text": "And when we disagree…"
    },
    {
      "row": "P10",
      "start": 93.95,
      "end": 95.58,
      "text": "The Tribunal."
    },
    {
      "row": "E2",
      "start": 98.05,
      "end": 99.17,
      "text": "…Both."
    },
    {
      "row": "E3",
      "start": 99.21,
      "end": 100.34,
      "text": "Rent's free."
    },
    {
      "row": "E3",
      "start": 100.34,
      "end": 102.247,
      "text": "They're both MIT."
    }
  ]
}